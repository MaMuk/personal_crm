<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="partner_list" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">partner_list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded border object-fit-contain'}" width="30" nolabel="1"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'on_tag_click': 'edit_color'}" optional="show"/>
            </list>
        </field>
    </record>
    <record id="partner_kanban" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">personal_crm.partner.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="o_res_partner_kanban_card flex-row gap-3">
                        <main class="gap-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="email" widget="email" invisible="not email"/>
                            <field name="phone" widget="phone" invisible="not phone"/>
                            <div class="text-muted" invisible="not city and not country_id">
                                <field name="city"/>
                                <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                                <field name="country_id"/>
                            </div>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'on_tag_click': 'edit_color'}" invisible="not category_id" class="m-0"/>
                        </main>
                        <aside class="d-flex align-items-start">
                            <field name="avatar_128" widget="image" options="{'size': [96, 96], 'img_class': 'rounded border object-fit-contain'}"/>
                        </aside>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="partner_search" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">partner_search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="category_id" string="Tags" operator="child_of"/>
                <field name="personal_crm_search_relationship_partner_id"/>
                <field name="personal_crm_search_relationship_type_id"/>
                <field name="personal_crm_search_relationship_category_id"/>
                <field name="personal_crm_search_relationship_date"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_tags" string="Tags" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="person_form" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">person_form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Personal CRM">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_personal_crm_network" groups="personal_crm.group_user" type="object" class="oe_stat_button" icon="account_tree" invisible="not id">
                            <div class="o_stat_info"><span class="o_stat_text">Network</span></div>
                        </button>
                    </div>
                    <div class="d-flex flex-column flex-md-row align-items-center gap-3 mb-4">
                        <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'size': [130, 130], 'img_class': 'border rounded h-100 object-fit-contain'}"/>
                        <field name="avatar_128" invisible="1"/>
                        <div class="oe_title w-100">
                            <h1>
                                <field name="name" class="text-break d-block" default_focus="1" placeholder="Name"/>
                            </h1>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="personal_crm_birthdate"/>
                            <field name="personal_crm_gender"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'on_tag_click': 'edit_color'}"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <field name="personal_crm_entity_type" widget="radio" options="{'horizontal': True}"/>
                    <field name="personal_crm_contact" invisible="1"/>
                    <notebook>
                        <page string="Personal notes">
                            <field name="personal_crm_note_ids" context="{'default_partner_ids': [(6, 0, [id])] if id else [], 'form_view_ref': 'personal_crm.note_form'}">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Network" name="relationship_network" groups="personal_crm.group_user">
                            <widget name="personal_crm_network"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_persons" model="ir.actions.act_window">
        <field name="name">People</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('personal_crm_entity_type', '=', 'person'), ('personal_crm_contact', '=', True)]</field>
        <field name="context">{'default_personal_crm_entity_type': 'person', 'default_personal_crm_contact': True}</field>
        <field name="search_view_id" ref="partner_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'sequence': 0, 'view_mode': 'list', 'view_id': ref('partner_list')}), (0, 0, {'sequence': 1, 'view_mode': 'kanban', 'view_id': ref('partner_kanban')}), (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('person_form')})]"/>
    </record>
    <record id="company_form" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">company_form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Personal CRM">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_personal_crm_network" groups="personal_crm.group_user" type="object" class="oe_stat_button" icon="account_tree" invisible="not id">
                            <div class="o_stat_info"><span class="o_stat_text">Network</span></div>
                        </button>
                    </div>
                    <div class="d-flex flex-column flex-md-row align-items-center gap-3 mb-4">
                        <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'size': [130, 130], 'img_class': 'border rounded h-100 object-fit-contain'}"/>
                        <field name="avatar_128" invisible="1"/>
                        <div class="oe_title w-100">
                            <h1>
                                <field name="name" class="text-break d-block" default_focus="1" placeholder="Company name"/>
                            </h1>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'on_tag_click': 'edit_color'}"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <field name="personal_crm_entity_type" widget="radio" options="{'horizontal': True}"/>
                    <field name="personal_crm_contact" invisible="1"/>
                    <notebook>
                        <page string="Related contacts">
                            <field name="child_ids" context="{'default_personal_crm_contact': True, 'default_personal_crm_entity_type': 'person', 'form_view_ref': 'personal_crm.person_form'}">
                                <list>
                                    <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded border object-fit-contain'}" width="30" nolabel="1"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Personal notes">
                            <field name="personal_crm_note_ids" context="{'default_partner_ids': [(6, 0, [id])] if id else [], 'form_view_ref': 'personal_crm.note_form'}">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Network" name="relationship_network" groups="personal_crm.group_user">
                            <widget name="personal_crm_network"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_companies" model="ir.actions.act_window">
        <field name="name">Companies and authorities</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('personal_crm_entity_type', '=', 'company'), ('personal_crm_contact', '=', True)]</field>
        <field name="context">{'default_personal_crm_entity_type': 'company', 'default_personal_crm_contact': True}</field>
        <field name="search_view_id" ref="partner_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'sequence': 0, 'view_mode': 'list', 'view_id': ref('partner_list')}), (0, 0, {'sequence': 1, 'view_mode': 'kanban', 'view_id': ref('partner_kanban')}), (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('company_form')})]"/>
    </record>
</odoo>
