<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="note_list" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">note_list</field>
        <field name="model">personal.crm.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="partner_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="note_form" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">note_form</field>
        <field name="model">personal.crm.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="relationship_ids" widget="many2many_tags" options="{'no_create': True}" context="{'personal_crm_navigation': True}"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="note_search" model="ir.ui.view">
        <field name="inherit_id" eval="False"/>
        <field name="name">note_search</field>
        <field name="model">personal.crm.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="relationship_ids"/>
                <field name="body"/>
                <filter name="date" string="Date" date="date"/>
            </search>
        </field>
    </record>
    <record id="action_notes" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">personal.crm.note</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="note_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('note_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('note_form')})]"/>
    </record>
</odoo>
