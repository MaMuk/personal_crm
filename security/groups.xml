<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="privilege_personal_crm" model="res.groups.privilege">
        <field name="name">Personal CRM</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">Personal CRM User</field>
        <field name="privilege_id" ref="privilege_personal_crm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_user'))]"/>
    </record>
</odoo>
